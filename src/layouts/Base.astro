---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE, CATEGORIES } from '../site.config';

interface Props {
  title: string;
  description: string;
  schema?: object | object[];
  ogImage?: string; // ruta en /public, por defecto /og-default.png
  noindex?: boolean;
  section?: string; // slug de categoría activa en el menú
  overHero?: boolean; // cabecera transparente sobre la foto de portada
}
const { title, description, schema, ogImage = '/og-default.png', noindex = false, section, overHero = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
// La marca solo se añade si cabe: Google corta los títulos a unos 60 caracteres.
const fullTitle = title.includes(SITE.name) || title.length + SITE.name.length + 3 > 62 ? title : `${title} | ${SITE.name}`;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#17191b" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    {SITE.adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
        crossorigin="anonymous"
      ></script>
    )}
    {SITE.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
        <script is:inline define:vars={{ id: SITE.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
    {SITE.cloudflareAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: SITE.cloudflareAnalyticsToken })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class:list={["site-header", { over: overHero }]}>
      <div class="wrap">
        <a class="logo" href="/" aria-label={`${SITE.name} home`}>
          <span class="logo-mark"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#17191b" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10l8-6 8 6v10"></path><path d="M9 20v-6h6v6"></path></svg></span>
          <span class="logo-word">Site <span>Sums</span></span>
        </a>
        <nav class="nav-main" aria-label="Main">
          {CATEGORIES.map((c) => (
            <a href={`/${c.slug}/`} aria-current={section === c.slug ? 'page' : undefined}>{c.name}</a>
          ))}
          <a href="/about/">About</a>
        </nav>
        <div class="header-actions">
          <a class="btn icon-btn" href="/#calculators" aria-label="Find a calculator"><Icon name="search" size={20} /></a>
          <details class="menu-mobile">
            <summary class="btn icon-btn" aria-label="Menu"><Icon name="menu" size={20} /></summary>
            <nav class="panel" aria-label="Mobile">
              {CATEGORIES.map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}
              <a href="/about/">About</a>
              <a href="/contact/">Contact</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <span class="logo-word">Site <span>Sums</span></span>
          <p>Estimates are a guide only. Always confirm structural, plumbing, gas and electrical work with a licensed tradesperson.</p>
        </div>
        <div class="footer-cols">
          <div>
            <strong>Calculators</strong>
            {CATEGORIES.map((c) => <a href={`/${c.slug}/`}>{c.name}</a>)}
          </div>
          <div>
            <strong>Site</strong>
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy-policy/">Privacy Policy</a>
            <a href="/terms/">Terms</a>
          </div>
        </div>
      </div>
      <div class="footer-base"><div class="wrap"><span>© {new Date().getFullYear()} {SITE.name} · Made for Australia</span><a href="#content">Back to top ↑</a></div></div>
    </footer>
  </body>
</html>
