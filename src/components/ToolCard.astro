---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { getCategory, PHOTOS, type Tool } from '../site.config';

interface Props { tool: Tool }
const { tool: t } = Astro.props;
const cat = getCategory(t.category);
---
{t.ready ? (
  <a class="tool-card" href={`/${t.slug}/`}>
    <div class="ph">
      {PHOTOS[t.slug] ? <Photo name={t.slug} card /> : null}
      <span class="tag">{cat?.short}</span>
    </div>
    <div class="body">
      <span class="name">{t.title}</span>
      <span class="desc">{t.blurb}</span>
      <span class="go">Open calculator <Icon name="arrow" size={16} stroke={2.4} /></span>
    </div>
  </a>
) : (
  <div class="tool-card soon">
    <div class="body">
      <div class="top"><span class="icon-tile"><Icon name={t.icon} /></span><span class="pill pill-soon">Coming soon</span></div>
      <span class="name">{t.title}</span>
      <span class="desc">{t.blurb}</span>
    </div>
  </div>
)}
