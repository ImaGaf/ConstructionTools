---
import Icon from './Icon.astro';
import { getCategory, type Tool } from '../site.config';

interface Props { tool: Tool; feature?: boolean }
const { tool: t, feature = false } = Astro.props;
const cat = getCategory(t.category);
---
{feature && t.ready ? (
  <a class="tool-card tool-feature" href={`/${t.slug}/`}>
    <div style="flex: 1 1 220px; min-width: 0;">
      <div class="meta"><span class="pill pill-hot">Most used</span><span>{cat?.name}</span></div>
      <div class="name">{t.title}</div>
      <p class="desc" style="margin: 0 0 20px;">{t.blurb}</p>
      <span class="go">Open calculator <Icon name="arrow" size={16} stroke={2.4} /></span>
    </div>
    <svg width="190" height="130" viewBox="0 0 190 130" aria-hidden="true">
      <path d="M20 52 L100 22 L170 52 L90 82 Z" fill="#2a3038" stroke="#f7a66b" stroke-width="2" stroke-linejoin="round"></path>
      <path d="M20 52 L20 72 L90 102 L90 82 Z" fill="#22272e" stroke="#f7a66b" stroke-width="2" stroke-linejoin="round"></path>
      <path d="M90 82 L90 102 L170 72 L170 52 Z" fill="#1e2328" stroke="#f7a66b" stroke-width="2" stroke-linejoin="round"></path>
    </svg>
  </a>
) : t.ready ? (
  <a class="tool-card" href={`/${t.slug}/`}>
    <div class="top"><span class="icon-tile"><Icon name={t.icon} /></span></div>
    <div><div class="name">{t.title}</div><div class="desc">{t.blurb}</div></div>
    <span class="go">Open <Icon name="arrow" size={16} stroke={2.4} /></span>
  </a>
) : (
  <div class="tool-card">
    <div class="top"><span class="icon-tile"><Icon name={t.icon} /></span><span class="pill pill-soon">Coming soon</span></div>
    <div><div class="name">{t.title}</div><div class="desc">{t.blurb}</div></div>
  </div>
)}
