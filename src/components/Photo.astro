---
// Foto de fondo para bandas y tarjetas (con parallax por CSS en .ph).
import { photo } from '../site.config';
interface Props { name: string; eager?: boolean; card?: boolean; credit?: boolean }
const { name, eager = false, card = false, credit = false } = Astro.props;
const p = photo(name);
---
{p && (
  <>
    <img
      class={card ? undefined : 'ph-img'}
      src={`/images/${name}${card ? '-sm' : ''}.webp`}
      srcset={card ? undefined : `/images/${name}-sm.webp 800w, /images/${name}.webp 1600w`}
      sizes={card ? undefined : '100vw'}
      width={card ? 800 : 1600}
      height={card ? 533 : 1000}
      alt={p.alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
    {credit && <span class="photo-credit">Photo: {p.by} / Unsplash</span>}
  </>
)}
