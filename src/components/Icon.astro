---
// Íconos de trazo en línea. Uso: <Icon name="slab" size={24} />
// Decorativos por defecto (aria-hidden). Para un ícono con significado pasa `label`.
import type { IconName } from '../site.config';

interface Props { name: IconName; size?: number; stroke?: number; label?: string; class?: string }
const { name, size = 24, stroke = 2, label, class: cls } = Astro.props;

const paths: Record<IconName, string> = {
  file: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 13h6M9 17h6"/>',
  sheet: '<rect x="3" y="4" width="18" height="16"/><path d="M3 9h18M3 14h18M9 4v16"/>',
  slab: '<path d="M2 11 L12 6 L22 11 L12 16 Z"/><path d="M2 11 V14 L12 19 V16"/><path d="M22 11 V14 L12 19"/>',
  driveway: '<path d="M8 3 L4 21 M16 3 L20 21"/><path d="M12 5v2M12 11v2M12 17v2"/>',
  stairs: '<path d="M3 20h5v-4h4v-4h4V8h5"/><path d="M3 20h18V8"/>',
  tile: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18M12 3v18"/>',
  bath: '<path d="M4 12h16v3a4 4 0 01-4 4H8a4 4 0 01-4-4z"/><path d="M6 12V6a2 2 0 014 0"/><path d="M7 19l-1 2M17 19l1 2"/>',
  kitchen: '<path d="M3 10h18v3a6 6 0 01-6 6H9a6 6 0 01-6-6z"/><path d="M8 6c0-1 1-2 1-3M12 6c0-1 1-2 1-3M16 6c0-1 1-2 1-3"/>',
  hotwater: '<rect x="6" y="3" width="12" height="18" rx="3"/><path d="M12 8c-1.5 2-2.5 3.2-2.5 4.5a2.5 2.5 0 005 0C14.5 11.2 13.5 10 12 8z"/>',
  gravel: '<path d="M3 18h18"/><path d="M5 18c1-5 4-8 7-8s6 3 7 8"/><circle cx="9" cy="14" r="1"/><circle cx="14" cy="13" r="1"/>',
  pipe: '<path d="M3 7h8a3 3 0 013 3v4a3 3 0 003 3h4"/><path d="M3 4v6M21 14v6"/>',
  dollar: '<circle cx="12" cy="12" r="9"/><path d="M15 9.5c-.5-1-1.6-1.5-3-1.5-1.7 0-3 .8-3 2s1.3 1.6 3 2 3 .8 3 2-1.3 2-3 2c-1.4 0-2.5-.5-3-1.5M12 6.5v11"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M20 6L9 17l-5-5"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>',
  link: '<path d="M15 7h3a4 4 0 010 8h-3M9 17H6a4 4 0 010-8h3M8 12h8"/>',
  print: '<path d="M6 9V3h12v6M6 18H4v-7h16v7h-2"/><rect x="6" y="14" width="12" height="7"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  shield: '<path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/>',
  ruler: '<path d="M4 19h16M4 15h10M4 11h16M4 7h7"/>',
  grid: '<path d="M3 7h18M3 12h18M3 17h18"/><path d="M7 4v16"/>',
};
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={paths[name]}
/>
