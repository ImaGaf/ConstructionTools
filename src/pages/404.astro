---
import Base from '../layouts/Base.astro';
import { TOOLS } from '../site.config';
---
<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <h1>Page not found</h1>
  <p class="lede">That page doesn't exist or has moved. Try one of our calculators instead.</p>
  <ul class="tool-list">
    {TOOLS.filter((t) => t.ready).map((t) => (
      <li><a href={`/${t.slug}/`}><div class="card"><strong>{t.title}</strong><br /><span class="note">{t.blurb}</span></div></a></li>
    ))}
  </ul>
  <p><a href="/">Back to the home page</a></p>
</Base>
