import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---
<Base title="About" description={`About ${SITE.name} and how our calculators work.`}>
  <h1>About {SITE.name}</h1>
  <p>{SITE.name} builds free calculators for Australian homeowners, DIYers and tradies planning building, renovation and plumbing work.</p>
  <p>Each tool shows the formula it uses, so you can check the maths yourself. Results are estimates to help you plan and compare quotes. They are not a substitute for advice from a licensed tradesperson or engineer.</p>
  <h2>Who is behind it</h2>
