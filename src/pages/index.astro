---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ToolCard from '../components/ToolCard.astro';
import Photo from '../components/Photo.astro';
import { SITE, TOOLS, CATEGORIES } from '../site.config';

const home = new URL('/', Astro.site).href;
// Listas para buscar: primero las disponibles, luego las próximas.
const featured = TOOLS.find((t) => t.featured && t.ready);
const CAT_ICON: Record<string, 'slab' | 'dollar' | 'pipe'> = { materials: 'slab', 'renovation-costs': 'dollar', 'plumbing-hot-water': 'pipe' };
const CAT_TEXT: Record<string, string> = {
  materials: 'Concrete, tiles and steps: how much to order, with waste included.',
  'renovation-costs': 'Bathrooms, kitchens and driveways, item by item, with sources.',
  'plumbing-hot-water': 'Hot water replacement, rebates and drainage falls.',
};
const ordered = [...TOOLS].sort((a, b) => Number(b.ready) - Number(a.ready) || Number(!!b.featured) - Number(!!a.featured));
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: home,
    inLanguage: 'en-AU',
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: home,
    logo: new URL('/apple-touch-icon.png', Astro.site).href,
    email: SITE.contactEmail,
  },
];
import DiagramDefs from '../components/DiagramDefs.astro';
---
<Base title={`${SITE.name} – Free Building & Renovation Calculators`} description={SITE.description} schema={schema} overHero>
  <section class="ph hero">
    <Photo name="home-hero" eager />
    <div class="shade"></div>
    <div class="wrap hero-copy">
      <p class="eyebrow">Free · Metric · Made for Australia</p>
      <h1>Plan the job.<br />Order the <em>right amount.</em></h1>
      <p class="lede">
        Calculators for concrete, tiles, renovation costs, hot water and drainage, with the working
        shown so you can check every number before you buy or get quotes.
      </p>
      <form class="search" role="search" action="/#calculators" id="search-form">
        <label for="q" class="sr-only">Search calculators</label>
        <span class="ic"><Icon name="search" size={20} /></span>
        <input id="q" name="q" type="search" placeholder="What are you working on? e.g. concrete slab" autocomplete="off" />
        <button class="btn btn-primary" type="submit">Find</button>
      </form>
      <div class="popular">
        <span>Popular:</span>
        <a class="chip" href="/concrete-calculator/?shape=slab">Concrete slab</a>
        <a class="chip" href="/bathroom-renovation-cost-calculator/">Bathroom cost</a>
        <a class="chip" href="/pipe-fall-calculator/">Pipe fall</a>
      </div>
    </div>
  </section>

  <section class="cats" aria-label="Categories">
    <div class="wrap">
      <div class="cats-grid">
        {featured && (
          <a class="ph cat-tile feat" href={`/${featured.slug}/`}>
            <Photo name="cat-materials" card />
            <div class="shade"></div>
            <p class="eyebrow" style="margin-bottom: 0;">Most used</p>
            <h3>{featured.title}</h3>
            <p>{featured.blurb}</p>
          </a>
        )}
        {CATEGORIES.map((c, i) => (
          <a class={`cat-tile t${i + 1}`} href={`/${c.slug}/`}>
            <Icon name={CAT_ICON[c.slug] ?? 'grid'} size={40} stroke={1.6} />
            <h3>{c.name}</h3>
            <p>{CAT_TEXT[c.slug] ?? c.intro.split('. ')[0] + '.'}</p>
            <span class="arrow" aria-hidden="true"><Icon name="arrow" size={18} stroke={2.2} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="dark who" aria-labelledby="who-h">
    <div class="wrap">
      <div class="who-copy">
        <p class="eyebrow">Who builds it</p>
        <h2 id="who-h">Built on real <em>hydraulic design</em> experience</h2>
        <p class="big-p">{SITE.name} is made by {SITE.author.name}, who models water supply and drainage for houses in Revit and works with Australian trade businesses.</p>
        <p>Every calculator shows its formula and every cost page lists its sources and dates, so you can check the numbers yourself.</p>
        <p style="margin-top: 30px;"><a class="btn btn-primary" href="/about/">About {SITE.name}</a></p>
      </div>
      <div class="who-visual">
        <div class="frame" aria-hidden="true"></div>
        <div class="ph"><Photo name="about-measure" /></div>
        <figure>
          <DiagramDefs />
          <svg viewBox="0 0 380 170" width="100%" role="img" aria-label="Isometric drawing of a 4 by 3 metre slab, 100 millimetres thick">
            <g id="g-hero"></g>
          </svg>
          <figcaption>4.0 × 3.0 × 0.10 m = 1.20 m³ + 10% = 1.32 m³</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="how dark" aria-labelledby="how-h">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">From tape measure to <em>quote</em></h2>
      </div>
      <ol>
        <li><span class="bignum" aria-hidden="true">01</span><Icon name="ruler" size={40} stroke={1.6} /><h3>Measure</h3><p>Metres and millimetres, the way they're written on your plans. Defaults use common Australian sizes.</p></li>
        <li><span class="bignum" aria-hidden="true">02</span><Icon name="grid" size={40} stroke={1.6} /><h3>Calculate</h3><p>Results update as you type, drawn to scale with your numbers.</p></li>
        <li><span class="bignum" aria-hidden="true">03</span><Icon name="check" size={40} stroke={1.6} /><h3>Check the working</h3><p>Every result shows the formula, and cost pages list their sources.</p></li>
        <li><span class="bignum" aria-hidden="true">04</span><Icon name="file" size={40} stroke={1.6} /><h3>Save &amp; compare</h3><p>Download your estimate as PDF or Excel, or share the link with your tradie.</p></li>
      </ol>
    </div>
  </section>

  <div class="wrap">
    <section class="section" id="calculators" aria-labelledby="calc-h">
      <div class="section-head">
        <div>
          <p class="eyebrow">Calculators</p>
          <h2 id="calc-h">Pick your job</h2>
        </div>
        <div class="seg filters" role="group" aria-label="Filter by category">
          <button type="button" aria-pressed="true" data-filter="all">All</button>
          {CATEGORIES.map((c) => <button type="button" aria-pressed="false" data-filter={c.slug}>{c.short}</button>)}
        </div>
      </div>
      <ul class="tools-grid" id="tools">
        {ordered.map((t) => (
          <li data-cat={t.category} data-text={`${t.title} ${t.blurb}`.toLowerCase()}>
            <ToolCard tool={t} />
          </li>
        ))}
      </ul>
      <p class="tools-empty" id="tools-empty" hidden>
        No calculator matches that yet. <a href="/contact/">Tell us what you need</a>.
      </p>
    </section>
  </div>

  <section class="ph band-photo" aria-labelledby="band-h">
    <Photo name="home-band" />
    <div class="shade"></div>
    <div class="inner">
      <p class="eyebrow">No black boxes</p>
      <h2 id="band-h">Every result shows <em>its working</em></h2>
      <p>Formulas on every calculator. Sources and dates on every cost page. Estimates you can take to a tradie and question.</p>
      <a class="btn btn-primary" href="/concrete-calculator/">Try the concrete calculator</a>
    </div>
  </section>

  <script>
    import { drawSlab } from '../lib/diagram-concrete';
    drawSlab('g-hero', 4, 3, 100);
    const list = document.getElementById('tools');
    const items = Array.from(list?.querySelectorAll<HTMLLIElement>('li') ?? []);
    const empty = document.getElementById('tools-empty');
    const input = document.getElementById('q') as HTMLInputElement | null;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    let cat = 'all';

    function apply() {
      const q = (input?.value ?? '').trim().toLowerCase();
      const words = q.split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((li) => {
        const okCat = cat === 'all' || li.dataset.cat === cat;
        const okText = words.every((w) => li.dataset.text?.includes(w));
        li.hidden = !(okCat && okText);
        if (!li.hidden) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }

    buttons.forEach((b) => b.addEventListener('click', () => {
      cat = b.dataset.filter ?? 'all';
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    }));
    input?.addEventListener('input', apply);
    document.getElementById('search-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      apply();
      document.getElementById('calculators')?.scrollIntoView({ behavior: 'smooth' });
    });

    const q0 = new URLSearchParams(location.search).get('q');
    if (q0 && input) { input.value = q0; apply(); }
  </script>
</Base>
