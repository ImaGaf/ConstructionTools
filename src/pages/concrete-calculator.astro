---
import CalculatorLayout, { type Faq, type TocItem } from '../layouts/CalculatorLayout.astro';
import Icon from '../components/Icon.astro';
import DiagramDefs from '../components/DiagramDefs.astro';

const toc: TocItem[] = [
  { id: 'formula', label: 'The formula' },
  { id: 'how-many-bags', label: 'How many bags?' },
  { id: 'footings-posts', label: 'Footings, piers & posts' },
  { id: 'thickness', label: 'Slab thickness by job' },
  { id: 'bags-or-ready-mix', label: 'Bags, mini-mix or ready-mix' },
  { id: 'concrete-cost', label: 'Working out the cost' },
  { id: 'before-you-pour', label: 'Before you pour' },
];

const faqs: Faq[] = [
  {
    q: 'How many 20 kg bags of concrete are in a cubic metre?',
    a: 'Roughly 100 to 110 bags, because a 20 kg bag of premix usually makes around 0.009–0.01 m³ once mixed. Yields vary by brand, so check the bag label and choose the matching bag size in the calculator.',
  },
  {
    q: 'How do I calculate how much concrete I need?',
    a: 'Multiply length × width × depth, all in metres, to get cubic metres (m³). For a 4 m × 3 m slab that is 100 mm thick: 4 × 3 × 0.1 = 1.2 m³. Then add 5–10% for waste, uneven ground and spillage.',
  },
  {
    q: 'How many bags of concrete do I need for a fence post?',
    a: 'For a typical 90 mm post in a 300 mm wide, 600 mm deep hole, each hole needs about 0.04 m³, which is roughly 4 to 5 bags of 20 kg premix including some waste. Use the Post holes option to work it out for your hole size and number of posts.',
  },
  {
    q: 'Should I use bags or order ready-mix concrete?',
    a: 'Bags suit small jobs such as setting posts or a small pad. Once a job needs more than about half a cubic metre, mixing by hand gets slow and tiring, and a ready-mix truck is usually easier and gives a more consistent pour. Ask local suppliers about minimum order sizes and short-load fees.',
  },
  {
    q: 'Can I mix concrete by hand?',
    a: 'Yes, for small jobs. A wheelbarrow or mixing tray and a shovel are enough for a few bags at a time. Beyond about a dozen bags it becomes slow, tiring and hard to keep the pour even, so hire a small mixer or order a mini-mix or ready-mix load instead.',
  },
  {
    q: 'How much does concrete cost per m³?',
    a: 'It depends on your city, the strength (MPa), the load size and the supplier, and small loads usually carry an extra short-load fee. Ask two or three local suppliers for a delivered price per m³, then enter it in the calculator to see your total.',
  },
  {
    q: 'How thick should a concrete slab be?',
    a: 'It depends on what the slab carries. Paths are often 75–100 mm, and driveways for cars are commonly 100–125 mm with reinforcement. Structural slabs for houses are designed by an engineer to AS 2870, so do not guess those.',
  },
  {
    q: 'How much extra concrete should I order?',
    a: 'Most people add 5–10%. Use the higher end if the ground is uneven, the formwork is irregular, or you are pouring footings into dug trenches, where the actual volume is often more than planned.',
  },
];
---
<CalculatorLayout
  slug="concrete-calculator"
  title="Concrete Calculator (m³ & Bags) – Slabs, Footings, Posts"
  description="Free concrete calculator for Australia. Work out cubic metres and 20 kg or 30 kg premix bags for slabs, footings and post holes, with waste included."
  h1="Concrete Calculator"
  lede="How many cubic metres and premix bags you need for a slab, footing or post holes, with waste included. Share the result with a link."
  updated="2026-11-18"
  quickAnswer="multiply length × width × depth in metres to get cubic metres, then add 5–10% for waste. A 4 m × 3 m slab, 100 mm thick, needs about 1.3 m³, or roughly 140 bags of 20 kg premix."
  toc={toc}
  faqs={faqs}
  cta={{ title: 'Pouring a driveway or large slab?', sub: 'Get it quoted by a licensed concreter', href: '#before-you-pour' }}
>
  <!-- ───────── Entradas ───────── -->
  <div slot="inputs">
    <div class="step">
      <div class="step-head"><span class="n">1</span><h2 id="shape-h">What are you pouring?</h2></div>
      <fieldset class="choice-grid" aria-labelledby="shape-h">
        <label class="choice">
          <input type="radio" name="shape" value="slab" data-state checked />
          <svg width="64" height="40" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 18 L32 6 L60 18 L32 30 Z"></path><path d="M4 18 V24 L32 36 V30"></path><path d="M60 18 V24 L32 36"></path></svg>
          <span class="t">Slab / pad</span>
          <span class="d">Paths, sheds, tank pads, driveways</span>
        </label>
        <label class="choice">
          <input type="radio" name="shape" value="footing" data-state />
          <svg width="64" height="40" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 12 H60"></path><path d="M14 12 V30 H50 V12"></path><path d="M14 22 H50" stroke-dasharray="3 3"></path></svg>
          <span class="t">Strip footing</span>
          <span class="d">Trenches for walls and retaining walls</span>
        </label>
        <label class="choice">
          <input type="radio" name="shape" value="post" data-state />
          <svg width="64" height="40" viewBox="0 0 64 40" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M2 12 H62"></path><path d="M10 12 V34 H26 V12"></path><path d="M38 12 V34 H54 V12"></path><rect x="15" y="2" width="6" height="28"></rect><rect x="43" y="2" width="6" height="28"></rect></svg>
          <span class="t">Post holes</span>
          <span class="d">Fences, pergolas, decks, letterboxes</span>
        </label>
      </fieldset>
    </div>

    <div class="step">
      <div class="step-head"><span class="n">2</span><h2>Measurements</h2></div>
      <div class="fields" data-panel="slab">
        <div><label for="s-l">Length</label><div class="field"><input id="s-l" type="number" inputmode="decimal" min="0" step="0.1" value="4" data-state /><span class="unit">m</span></div></div>
        <div><label for="s-w">Width</label><div class="field"><input id="s-w" type="number" inputmode="decimal" min="0" step="0.1" value="3" data-state /><span class="unit">m</span></div></div>
        <div><label for="s-d">Thickness</label><div class="field"><input id="s-d" type="number" inputmode="decimal" min="0" step="5" value="100" data-state /><span class="unit">mm</span></div></div>
      </div>
      <div class="fields" data-panel="footing" hidden>
        <div><label for="f-l">Total length</label><div class="field"><input id="f-l" type="number" inputmode="decimal" min="0" step="0.1" value="10" data-state /><span class="unit">m</span></div></div>
        <div><label for="f-w">Width</label><div class="field"><input id="f-w" type="number" inputmode="decimal" min="0" step="10" value="300" data-state /><span class="unit">mm</span></div></div>
        <div><label for="f-d">Depth</label><div class="field"><input id="f-d" type="number" inputmode="decimal" min="0" step="10" value="400" data-state /><span class="unit">mm</span></div></div>
      </div>
      <div class="fields" data-panel="post" hidden>
        <div><label for="p-n">Number of holes</label><div class="field"><input id="p-n" type="number" inputmode="numeric" min="0" step="1" value="6" data-state /><span class="unit">holes</span></div></div>
        <div><label for="p-dia">Hole diameter</label><div class="field"><input id="p-dia" type="number" inputmode="decimal" min="0" step="10" value="300" data-state /><span class="unit">mm</span></div></div>
        <div><label for="p-d">Hole depth</label><div class="field"><input id="p-d" type="number" inputmode="decimal" min="0" step="10" value="600" data-state /><span class="unit">mm</span></div></div>
        <div><label for="p-post">Post size (square)</label><div class="field"><input id="p-post" type="number" inputmode="decimal" min="0" step="5" value="90" data-state /><span class="unit">mm</span></div></div>
      </div>
    </div>

    <div class="step">
      <div class="step-head"><span class="n">3</span><h2>Options</h2></div>
      <div class="options">
        <div>
          <div class="opt-label" id="waste-l">Extra for waste</div>
          <div class="seg" role="radiogroup" aria-labelledby="waste-l">
            <label><input type="radio" name="waste" value="0" data-state />None</label>
            <label><input type="radio" name="waste" value="5" data-state />5%</label>
            <label><input type="radio" name="waste" value="10" data-state checked />10%</label>
            <label><input type="radio" name="waste" value="15" data-state />15%</label>
          </div>
        </div>
        <div>
          <div class="opt-label" id="bag-l">Premix bag size</div>
          <div class="seg" role="radiogroup" aria-labelledby="bag-l">
            <label><input type="radio" name="bag" value="20" data-state checked />20 kg</label>
            <label><input type="radio" name="bag" value="30" data-state />30 kg</label>
          </div>
        </div>
        <div class="grow">
          <label class="opt-label" for="price">Ready-mix price per m³ <span class="muted">(optional)</span></label>
          <div class="field"><span class="unit" style="padding: 0 6px 0 0;">$</span><input id="price" type="number" inputmode="decimal" min="0" step="10" placeholder="Your quote" data-state /><span class="unit">/m³</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ───────── Resultado ───────── -->
  <div slot="result">
    <div class="diagram">
      <DiagramDefs />
      <div data-diagram="slab"><svg viewBox="0 0 380 170" role="img" aria-labelledby="dg-slab">
        <title id="dg-slab">Slab drawn to your length, width and thickness</title>
        <g id="g-slab"></g>
      </svg></div>
      <div data-diagram="footing" hidden><svg viewBox="0 0 380 170" role="img" aria-labelledby="dg-footing">
        <title id="dg-footing">Cross-section of the strip footing with your width and depth</title>
        <g id="g-footing"></g>
      </svg></div>
      <div data-diagram="post" hidden><svg viewBox="0 0 380 170" role="img" aria-labelledby="dg-post">
        <title id="dg-post">Cross-section of a post hole with your diameter and depth</title>
        <g id="g-post"></g>
      </svg></div>
    </div>

    <div class="result-body" aria-live="polite">
      <div class="big"><div class="k">Concrete needed</div><div class="v" id="r-m3">–</div></div>
      <div class="stats">
        <div class="stat stat-accent"><div class="k" id="r-bag-label">20 kg premix bags</div><div class="v" id="r-bags">–</div></div>
        <div class="stat stat-plan"><div class="k">Order ready-mix</div><div class="v" id="r-order">–</div></div>
        <div class="stat stat-plan" id="r-cost-wrap" hidden style="grid-column: span 2;"><div class="k">Ready-mix estimate at your price</div><div class="v" id="r-cost">–</div></div>
      </div>

      <div class="meter-labels" aria-hidden="true"><span>Bags</span><span>Either</span><span>Truck</span></div>
      <div class="meter" aria-hidden="true"><i></i><i></i><i></i><span class="dot" id="r-dot"></span></div>
      <p class="hint" id="r-hint"></p>

      <p class="working" id="r-working"></p>

      <div class="result-actions">
        <button type="button" class="btn" id="copy-link"><Icon name="link" size={18} />Copy link to result</button>
        <button type="button" class="btn icon-btn" id="print" aria-label="Print result"><Icon name="print" size={18} /></button>
      </div>
      <p class="copy-status" id="copy-status" role="status"></p>
    </div>
  </div>

  <!-- ───────── Artículo ───────── -->
  <section id="formula">
    <h2>How to calculate concrete for a slab</h2>
    <div class="step-cards">
      <div><b>STEP 1</b>Convert every measurement to metres. 100 mm = 0.1 m.</div>
      <div><b>STEP 2</b>Multiply length × width × depth to get cubic metres.</div>
      <div><b>STEP 3</b>Add 5–10% so you don't run short mid-pour.</div>
    </div>
    <p>
      Concrete is sold by volume, in cubic metres. A 4 m × 3 m pad that is 100 mm thick works out
      to 4 × 3 × 0.1 = 1.2 m³, and with 10% extra you would plan for about 1.32 m³.
    </p>
    <p>
      The margin matters. Ground is rarely perfectly level, formwork bows a little, and some
      concrete always stays in the barrow or the chute. Running short halfway through a pour
      leaves a cold joint, which is far worse than having a little left over. For an L-shaped
      slab, split it into rectangles, work out each one and add them together.
    </p>
  </section>

  <section id="how-many-bags">
    <h2>How many bags of concrete do I need?</h2>
    <p>
      Divide the volume by what one bag makes. A 20 kg bag of general-purpose premix makes
      roughly 0.0095 m³, so one cubic metre takes about 105 bags before waste. A 30 kg bag makes
      roughly 0.014 m³, or about 72 bags per cubic metre. Yields vary between brands, so check the
      label on the bag you're buying.
    </p>
    <div class="table-card">
      <table>
        <thead><tr><th scope="col">Volume</th><th scope="col">20 kg bags</th><th scope="col">30 kg bags</th></tr></thead>
        <tbody>
          <tr><td>0.1 m³</td><td>11</td><td>8</td></tr>
          <tr><td>0.25 m³</td><td>27</td><td>18</td></tr>
          <tr><td>0.5 m³</td><td>53</td><td>36</td></tr>
          <tr><td>1 m³</td><td>106</td><td>72</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">Before waste. Add 5–10% on top, as the calculator does.</p>
    <p>
      For fence and pergola posts, many people use a fast-setting post mix instead of standard
      premix. Some of these are designed to be poured dry into the hole and then wetted, so the
      number of bags per hole can differ: follow the instructions on the bag.
    </p>
  </section>

  <section id="footings-posts">
    <h2>Footings, piers and post holes</h2>
    <p>
      A strip footing is a long, narrow slab, so the same formula applies: total length × width ×
      depth. For round post holes, the calculator works out the volume of each cylinder
      (π × radius² × depth), takes away the space the post itself fills, and multiplies by the
      number of holes. For round concrete piers or pier footings with no post set in them, enter
      a post size of 0.
    </p>
    <p>
      Dug holes and trenches usually end up wider than planned, which is why 10% extra is a
      sensible default for these jobs.
    </p>
  </section>

  <section id="thickness">
    <h2>How thick should a concrete slab be?</h2>
    <div class="table-card">
      <table>
        <thead><tr><th scope="col">Job</th><th scope="col">Common thickness</th></tr></thead>
        <tbody>
          <tr><td>Garden path, light foot traffic</td><td>75–100 mm</td></tr>
          <tr><td>Shed or water tank pad</td><td>100 mm</td></tr>
          <tr><td>Driveway for cars</td><td>100–125 mm, reinforced</td></tr>
          <tr><td>House slab or footings</td><td>Engineer-designed (AS 2870)</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">
      Common starting points, not a design. Your council, the tank or shed manufacturer, or an
      engineer may require something different.
    </p>
  </section>

  <section id="bags-or-ready-mix">
    <h2>Bags, mini-mix or ready-mix?</h2>
    <p>The calculator's Bags–Truck bar shows where your job falls. As a rule of thumb:</p>
    <div class="compare">
      <div class="c1"><h3>Under 0.3 m³</h3>Premix bags, mixed by hand or in a small mixer. Posts and small pads.</div>
      <div class="c2"><h3>0.3–0.6 m³</h3>Either. Compare bag cost and effort with a mini-mix or a ready-mix short load.</div>
      <div class="c3"><h3>Over 0.6 m³</h3>Ready-mix delivered by truck. Driveways and larger slabs.</div>
    </div>
    <p style="margin-top: 16px;">
      <strong>Mini-mix</strong> services use smaller trucks for small loads and tight access, which
      makes them a common choice for jobs too big for bags but too small for a full ready-mix
      truck. When you ask for quotes, give the supplier your volume in m³ from the calculator and
      ask whether a minimum load or short-load fee applies.
    </p>
  </section>

  <section id="concrete-cost">
    <h2>Working out the cost of your concrete</h2>
    <p>
      Concrete is priced per cubic metre delivered, and the price changes with your location,
      the strength you need (measured in MPa), the size of the load and how far the truck travels.
      Extras such as a concrete pump, colour or exposed-aggregate finishes, and short-load fees are
      added on top. The <a href="/concrete-price-per-m3/">concrete price per m³ calculator</a> estimates the
      delivered cost by city, and the <a href="/concrete-driveway-cost/">concrete driveway cost calculator</a> prices
      a whole driveway, labour included.
    </p>
    <p>
      To estimate the material cost, get a delivered price per m³ from a couple of local suppliers
      and enter it in the <em>Ready-mix price per m³</em> field above, or use our
      <a href="/concrete-price-per-m3/">concrete price per m³ calculator</a> for typical prices by
      city, short-load fees and pump hire. The calculator multiplies it
      by the rounded order volume. Labour, formwork, reinforcement and finishing are separate, so
      for a driveway or slab ask a concreter for a full quote.
    </p>
  </section>

  <section id="before-you-pour">
    <h2>Before you pour</h2>
    <ul class="checklist">
      <li><Icon name="check" size={20} stroke={2.2} /><span>Measure the formwork you actually built, not the plan.</span></li>
      <li><Icon name="check" size={20} stroke={2.2} /><span>Check access: can a truck reach the site, or will you need a pump or barrows?</span></li>
      <li><Icon name="check" size={20} stroke={2.2} /><span>Avoid pouring in extreme heat or when rain is forecast, as both affect the finish and strength.</span></li>
      <li><Icon name="check" size={20} stroke={2.2} /><span>Keep the slab damp for the first few days so it cures properly.</span></li>
    </ul>
    <div class="callout" style="margin-top: 24px;">
      <strong>Bigger job than a weekend pour?</strong>
      Driveways and large slabs need formwork, reinforcement and a crew on pour day. Get quotes
      from a licensed concreter before you order anything.
    </div>
  </section>
</CalculatorLayout>

<script>
  import { bindCalculator, num, fmt, setText, type State } from '../lib/calc';
  import { drawSlab, drawFooting, drawPost } from '../lib/diagram-concrete';

  const BAG_YIELD: Record<string, number> = { '20': 0.0095, '30': 0.014 }; // m³ por bolsa, aprox.

  function volume(s: State): { m3: number; working: string } {
    if (s.shape === 'footing') {
      const l = num(s['f-l']), w = num(s['f-w']) / 1000, d = num(s['f-d']) / 1000;
      drawFooting('g-footing', l, num(s['f-w']), num(s['f-d']));
      return { m3: l * w * d, working: `${fmt(l, 1)} × ${fmt(w, 3)} × ${fmt(d, 3)} m` };
    }
    if (s.shape === 'post') {
      const n = Math.floor(num(s['p-n']));
      const r = num(s['p-dia']) / 2000, depth = num(s['p-d']) / 1000, post = num(s['p-post']) / 1000;
      const each = Math.max(0, Math.PI * r * r * depth - post * post * depth);
      drawPost('g-post', n, num(s['p-dia']), num(s['p-d']), num(s['p-post']));
      return { m3: each * n, working: `${n} holes × ${fmt(each, 3)} m³ (hole minus post)` };
    }
    const l = num(s['s-l']), w = num(s['s-w']), d = num(s['s-d']) / 1000;
    drawSlab('g-slab', l, w, num(s['s-d']));
    return { m3: l * w * d, working: `${fmt(l, 1)} × ${fmt(w, 1)} × ${fmt(d, 3)} m` };
  }

  function render(s: State) {
    const shape = s.shape ?? 'slab';
    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== shape));
    document.querySelectorAll<HTMLElement>('[data-diagram]').forEach((d) => (d.hidden = d.dataset.diagram !== shape));

    const waste = num(s.waste) / 100;
    const bagKg = s.bag === '30' ? '30' : '20';
    const { m3: base, working } = volume({ ...s, shape });
    const m3 = base * (1 + waste);
    const bags = m3 > 0 ? Math.ceil(m3 / BAG_YIELD[bagKg]) : 0;
    const order = Math.ceil(m3 * 5) / 5; // redondeo a 0,2 m³

    setText('r-m3', `${fmt(m3)} m³`);
    setText('r-bags', bags.toLocaleString('en-AU'));
    setText('r-bag-label', `${bagKg} kg premix bags`);
    setText('r-order', `${fmt(order, 1)} m³`);
    setText('r-working', base > 0
      ? `${working} = ${fmt(base)} m³ + ${Math.round(waste * 100)}% waste = ${fmt(m3)} m³`
      : 'Enter your measurements to see the working.');

    const price = num(s.price);
    const costWrap = document.getElementById('r-cost-wrap');
    if (costWrap) costWrap.hidden = price <= 0;
    if (price > 0) {
      setText('r-cost', (order * price).toLocaleString('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 }));
    }

    const dot = document.getElementById('r-dot');
    if (dot) dot.style.left = `${Math.min(m3 / 1.2, 1) * 100}%`;
    setText('r-hint',
      m3 === 0 ? 'Enter your measurements to see the result.'
      : m3 < 0.3 ? 'Small job: premix bags are usually the easiest option.'
      : m3 < 0.6 ? 'In-between size: bags are possible but hard work. Compare with a ready-mix short load.'
      : 'At this size, ready-mix delivered by truck is usually the practical choice.');

    const label = shape === 'post' ? 'Post holes' : shape === 'footing' ? 'Strip footing' : 'Slab';
    setText('mbar-k', `${label} · ${Math.round(waste * 100)}% waste`);
    const v = document.getElementById('mbar-v');
    if (v) v.innerHTML = `${fmt(m3)} m³ <span>· ${bags.toLocaleString('en-AU')} bags</span>`;
  }

  const root = document.getElementById('calc');
  if (root) bindCalculator(root, render);
</script>
