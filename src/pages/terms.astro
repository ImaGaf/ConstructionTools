---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---
<Base title="Terms of Use" description={`Terms of use for ${SITE.name}.`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Terms of Use</span></nav>
    <div class="prose">
      <h1>Terms of Use</h1>
      <p>The calculators and information on {SITE.name} are provided free, as a general guide only. Results depend on the figures you enter and on simplifying assumptions, and may not suit your situation.</p>
      <p>Always confirm quantities, costs and compliance requirements with a licensed tradesperson, engineer or your local council before buying materials or starting work. {SITE.name} is not liable for losses arising from use of the site.</p>
    </div>
  </div>
</Base>
