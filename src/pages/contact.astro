---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
---
<Base title="Contact" description={`Contact ${SITE.name}.`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Contact</span></nav>
    <div class="prose">
      <h1>Contact</h1>
      <p>Questions, corrections or calculator ideas are welcome. Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a> and we will reply as soon as we can.</p>
    </div>
  </div>
</Base>
